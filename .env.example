TMDB_API_KEY=
# Optional. Override the TMDb API host. Defaults to https://api.themoviedb.org/3.
# Set to https://api.tmdb.org/3 if the primary host is blocked on your network.
TMDB_API_BASE_URL=
OMDB_API_KEY=

# Optional. Leave blank to disable web enrichment in local development.
WEB_SEARCH_API_KEY=

# Local development uses data/watchlist.json by default.
# Set to firebase only after Firestore is configured.
WATCHLIST_STORAGE=file
FIRESTORE_COLLECTION=watchlist_items
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# OpenAI ranking is opt-in to prevent accidental spend.
OPENAI_API_KEY=
OPENAI_RANKING_ENABLED=false
OPENAI_RANKING_MODEL=gpt-5-nano
# gpt-5 reasoning effort. "minimal" keeps reasoning tokens near zero so the JSON fits the
# output budget (and keeps cost down). Raise to "low"/"medium" only if you increase
# OPENAI_RANKING_MAX_OUTPUT_TOKENS to leave room for reasoning tokens.
OPENAI_RANKING_REASONING_EFFORT=minimal
OPENAI_RANKING_MONTHLY_BUDGET_USD=0.25
OPENAI_RANKING_MAX_ITEMS=40
OPENAI_RANKING_MAX_INPUT_CHARS=24000
OPENAI_RANKING_MAX_OUTPUT_TOKENS=900
OPENAI_RANKING_INPUT_USD_PER_MILLION=0.05
OPENAI_RANKING_OUTPUT_USD_PER_MILLION=0.40

# Set both to /mywatchlist for a Firebase origin proxied behind Cloudflare at vigneshsundhar.com/mywatchlist.
NEXT_PUBLIC_DEPLOY_ASSET_PREFIX=
NEXT_PUBLIC_WATCHLIST_BASE_PATH=/watchlist
