TMDB_API_KEY=
OMDB_API_KEY=

# Optional. Leave blank to disable web enrichment in local development.
WEB_SEARCH_API_KEY=

# Local development uses data/watchlist.json by default.
# Set to firebase only after Firestore is configured.
WATCHLIST_STORAGE=file
FIRESTORE_COLLECTION=watchlist_items
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# OpenAI ranking is opt-in to prevent accidental spend.
OPENAI_API_KEY=
OPENAI_RANKING_ENABLED=false
OPENAI_RANKING_MODEL=gpt-5-nano
OPENAI_RANKING_MONTHLY_BUDGET_USD=0.25
OPENAI_RANKING_MAX_ITEMS=40
OPENAI_RANKING_MAX_INPUT_CHARS=24000
OPENAI_RANKING_MAX_OUTPUT_TOKENS=900
OPENAI_RANKING_INPUT_USD_PER_MILLION=0.05
OPENAI_RANKING_OUTPUT_USD_PER_MILLION=0.40

# Set to /watchlist only for a Firebase origin proxied behind Cloudflare at vigneshsundhar.com/watchlist.
NEXT_PUBLIC_DEPLOY_ASSET_PREFIX=
